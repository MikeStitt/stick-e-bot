.idea/
.venv/
__pycache__/

# Sphinx output
instructions/*/build/
.docs/reviews/*/build/

# generated figure viewers
.docs/reviews/*/*-pictures.html

# ninja build state, regenerated on every run
.ninja_log
.ninja_deps
.ninja_lock

# Local Claude Code state. The contract under rules/ and skills/ is tracked.
.claude/*
!.claude/rules/
!.claude/skills/

# Interim capture never enters this tree. A take writes its frames to the session
# scratchpad, and `runs/` is where they would otherwise land, so raster and video
# are denied there and anywhere named capture/.
#
# The archive holds 13,962 screenshots, 1,837 MB, under this one path, because
# capture and publication shared a directory. src/stickbot/check_images.py
# enforces what this file requests. See .docs/2026-09-14-move-to-stick-e-bot.md.
#
# Elsewhere a raster is allowed, and the check is that something says where it
# came from: a guide's source/images/ publishes it, or a README records the
# document, workspace, tab and view it was rendered from.
**/capture/
.docs/experiments/runs/**/*.png
.docs/experiments/runs/**/*.jpg
.docs/experiments/runs/**/*.jpeg
.docs/experiments/runs/**/*.gif
.docs/experiments/runs/**/*.mp4
.docs/experiments/runs/**/*.mov
